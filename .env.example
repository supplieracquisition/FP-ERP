# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# --- Database ---------------------------------------------------------------
# Unset: local SQLite (fp-erp.db). Set: Postgres, used verbatim.
# Database choice is independent of auth mode, which is what lets you run real
# Supabase auth against a non-production copy of the data.
# DATABASE_URL=postgresql://...

# --- Auth -------------------------------------------------------------------
# Both set: real Supabase auth. Both unset: no auth system unless the dev stub
# below is explicitly enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Needed for admin operations such as inviting a supplier.
SUPABASE_SERVICE_ROLE_KEY=

# Local dev auth stub: email-only sign-in, any password accepted, plus a
# quick-switch user picker. A real authentication bypass — leave it unset
# unless you are deliberately developing without Supabase.
#
# Requires all three: this flag set to 1, no Supabase env above, and a
# non-production NODE_ENV. See lib/auth-mode.ts.
# NEXT_PUBLIC_ALLOW_DEV_AUTH_STUB=1

# Proxy-level gate on /api/*. Set to "enforce" to actually refuse unauthenticated
# API requests; anything else (including unset) logs what it would have refused
# and lets the request through. See proxy.ts.
# AUTH_GATE_API=enforce

# --- App --------------------------------------------------------------------
# Absolute origin used to build links in outgoing email (e.g. supplier invites).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for scheduled jobs, sent as `Authorization: Bearer <value>`.
CRON_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Bug reports ------------------------------------------------------------
BUG_REPORT_EMAIL=
BUG_REPORT_CC=

# --- Integrations -----------------------------------------------------------
GOOGLE_CHAT_WEBHOOK_URL=

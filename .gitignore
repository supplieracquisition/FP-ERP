# Uploaded order images — user data, never committed.
# public/uploads/ is the pre-2026-08-20 location, served with no auth. Two test
# print images were committed there before this rule existed; they are removed
# from the index but still need scrubbing from history.
public/uploads/
private-uploads/

# One-time import scripts and data artifacts
import_fabric_data.ts
fabric_details.csv
fabric_colors.csv

# Local SQLite databases — real data, never committed.
#
# These patterns stop a *new* database file from being added. They do not undo
# anything: .gitignore has no effect on paths git already tracks, so each one
# also needed `git rm --cached`. That has now been done for all of them —
# fp-erp.db and its -shm/-wal sidecars, then fp-erp.db.bak and
# fp-erp.db.backup-before-migration.
#
# Untracking only stops the exposure GROWING. Every byte already committed is
# still in history and still public; scrubbing that is separate, deferred work.
*.db
*.db-shm
*.db-wal

# Named explicitly as well: fp-erp.db is the live copy — real users, suppliers
# and orders — and the file this rule exists for.
fp-erp.db
fp-erp.db-shm
fp-erp.db-wal

# The backups need naming too. Neither matches *.db — one ends .bak, the other
# ends -before-migration — so extension patterns miss them, and so does any
# audit that scans by extension. Both hold real users, suppliers and orders.
fp-erp.db.bak
fp-erp.db.backup-before-migration
